  (text "USB-C power in, 5 V only (5.1 k on each CC), fed to the Pi through its header: a Power HAT+."
    (at 30.48 40.64 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "0f2c0994-63c8-47ca-a752-deb81fafc1ef")
  )
  (text "U6 lets current flow one way only, is off below 4.4 V and above 6.1 V, limits at 4 A, rises in 5 ms."
    (at 30.48 46.99 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "2a2b8d8b-ee79-4a4b-9a6e-cce863d0c3f8")
  )
  (text "Each CC line: 5.1 k to ground, and 10 k and 100 nF to an ADC pin of the RP2350,"
    (at 50.8 134.62 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "7dda6389-c894-453a-87b0-e6b7df13048e")
  )
  (text "which reads what the supply offers: 0.25-0.61 V default, 0.70-1.16 V 1.5 A, 1.31-2.04 V 3 A."
    (at 50.8 139.7 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "11edbaf0-a017-43cd-bcc5-a458ee444419")
  )
  (text "Fan: on while the Pi drives GPIO 12 high (gpio-fan). Off with the Pi off."
    (at 81.28 181.61 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "82329d69-bd0a-4fcb-b2d0-3bed902eb4c8")
  )
  (text "The Pi's 40-pin header. This board is a HAT under the Pi."
    (at 172.72 30.48 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "703b11c7-f622-40ed-8eda-1e10d180a769")
  )
  (text "HAT+ ID EEPROM"
    (at 274.32 43.18 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "46bbf3e6-4d35-4f53-a8d9-a4aa6d767a8a")
  )
  (text "Holes for the Pi's standoffs"
    (at 269.24 104.14 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "7039ce5b-7338-42ce-bc41-02368d3118be")
  )
