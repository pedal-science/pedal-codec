  (text "K2, drawn at rest: the tip goes to the bypass and leaves the buffer."
    (at 111.76 114.3 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "c6a165fa-d19c-457a-a35e-9fa7a8bbf723")
  )
  (text "Energised, the bypass trace is grounded."
    (at 111.76 119.38 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "bd43df22-72b6-4c4d-990c-fe7a39e1afde")
  )
  (text "GUITAR: bypass relay K2, 1 M to the mid-rail, follower, differential driver into codec input 1. The sleeve is the one bond to the case."
    (at 25.4 30.48 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "3b714df0-6805-4f15-9104-6e5a0e45c46b")
  )
  (text "MIC: XLR and 1/4 in wired in parallel, no phantom power. About 20 dB, into codec input 2."
    (at 25.4 132.08 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "3d8b4290-ff25-4375-997e-ea89fabdd052")
  )
  (text "One 22 uF 16 V in each leg, + toward the preamp. It would not survive 48 V put on this socket from outside."
    (at 25.4 137.16 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "e043c226-bcfb-4595-bac0-bbe2c50cb993")
  )
