  (text "K2, drawn at rest: the tip goes to the bypass and leaves the buffer."
    (at 111.76 114.3 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "792cc01d-c9ca-4e59-a2e1-84a7dad6ce2f")
  )
  (text "Energised, the bypass trace is grounded."
    (at 111.76 119.38 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "771875b4-0964-4378-9bff-7bc4e2b9be16")
  )
  (text "GUITAR: bypass relay K2, 1 M to the mid-rail, follower, differential driver into codec input 1. The sleeve is the one bond to the case."
    (at 25.4 30.48 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "0ae9ea51-b29b-4833-b3cc-d5442d0540c7")
  )
  (text "MIC: XLR and 1/4 in wired in parallel, no phantom power. About 20 dB, into codec input 2."
    (at 25.4 132.08 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "cc94dfa5-b0bc-49d6-abc4-264df987ab2d")
  )
