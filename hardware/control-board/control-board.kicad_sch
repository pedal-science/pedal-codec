  (text "Pedal box: control board"
    (at 25.4 20.32 0)
    (effects (font (size 3 3)) (justify left bottom))
    (uuid "1230ee3b-9be0-4ac5-8937-6481fc817bf9")
  )
  (text "Encoder, two buttons and their lamps, to the RP2350 on the Pi board over a 16-way 1.0 mm flat cable."
    (at 25.4 27.94 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "73dfad1e-9e8a-48db-a180-fcdced09e5e7")
  )
  (text "Pins 12 and 13 feed the two lamps, each through 330 R on the Pi board. 14 is spare. VDD is the RP2350's 3.3 V."
    (at 25.4 34.29 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "3e324de1-b1ee-4497-860e-7339d7db31fe")
  )
  (text "The encoder's lugs are not grounded: its bush is nutted to the case."
    (at 25.4 119.38 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "b162789a-875c-479b-8dfb-95a05e30e326")
  )
  (text "Bourns' filter: 10 k up, 10 k in series, 10 nF"
    (at 172.72 53.34 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "790dbdff-e458-4871-b9ba-66e0435ca25f")
  )
  (text "Switches: 10 k up, 1 k, 100 nF"
    (at 172.72 114.3 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "31cc8a83-068b-4b25-b8ee-e72cd32095c7")
  )
  (text "Lamps: 3 mm red, one through the face in"
    (at 25.4 125.984 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "00b2e2c6-43cc-4859-bcbf-7df02b32a529")
  )
  (text "front of each button. Soldered with the board"
    (at 25.4 131.064 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "719c2b5d-f1f1-4663-bb5e-da7da030ba08")
  )
  (text "in the case, each pushed up into its hole."
    (at 25.4 136.144 0)
    (effects (font (size 1.8 1.8)) (justify left bottom))
    (uuid "5abfe4d3-96f7-452e-ab2e-1883e5f052c5")
  )
